  "license": "MIT",
  "private": true,
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@react-three/fiber": "^9.7.0",
    "@remotion/cli": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/tailwind-v4": "4.0.537",
    "@remotion/three": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "@types/three": "^0.186.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "tailwindcss": "4.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
